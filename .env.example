# ===== Base de datos (Neon: Dashboard > Connect) =====
# Conexion con pooler (para la app en runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=25&pool_timeout=30"
# Conexion directa sin pooler (para migraciones de Prisma)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ===== App =====
NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"
# Genera con: openssl rand -base64 32
AUTH_SECRET=""

# ===== Administrador inicial (solo lo usa 
pm run db:seed) =====
ADMIN_EMAIL="admin@tu-dominio.com"
ADMIN_PASSWORD=""        # minimo 10 caracteres; si se deja vacio el seed genera una y la imprime una vez
ADMIN_NAME="Administrador"

# ===== Almacenamiento de imagenes y comprobantes: local | s3 =====
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage"          # (local) carpeta persistente; en Docker montar un volumen
# S3_ENDPOINT=""                # (s3) vacio para AWS; URL para R2/MinIO/Backblaze
# S3_REGION="us-east-1"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""         # (s3) opcional: base publica (CDN) para imagenes de catalogo

# ===== WhatsApp (opcional). Sin esto, las notificaciones solo se guardan en el panel =====
# WHATSAPP_PROVIDER="cloud_api"
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""

# ===== Correo saliente (opcional). Sin esto la recuperación de contraseña no envía correos =====
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="LUCIA JEANS <no-reply@tu-dominio.com>"

# ===== Docker =====
# RUN_MIGRATIONS="true"          # aplica `prisma migrate deploy` al iniciar el contenedor

# ===== Pruebas de integración (solo desarrollo) =====
# Base de datos SEPARADA (debe terminar en _test; las pruebas abortan si no). Conexión DIRECTA (sin pooler).
# Crear:  CREATE DATABASE neondb_test;   y luego migrar apuntando a esta URL (prisma migrate deploy).
# TEST_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb_test?sslmode=require"
